# ==============================================================================
# SMART HOSTEL & MESS MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Copy this file to .env before starting the backend application.
# NEVER commit real credentials, passwords, or secret keys to Git.
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String
# NOTE: MongoDB multi-document transactions require a Replica Set.
# For local dev, use MongoDB Community Server configured as a single-node replica set,
# or MongoDB Atlas free tier URI (e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/hostel_db).
MONGODB_URI=mongodb://localhost:27017/smart_hostel_db?replicaSet=rs0

# Initial One-Time Administrator Setup
# A strong, unguessable token required to call POST /api/v1/setup/initial-admin
# Once the first administrator is created, this route is automatically permanently locked.
ADMIN_SETUP_SECRET=replace_with_a_secure_random_string_min_32_chars

# Authentication & JWT Configuration
# Generate random 64-character hex strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Account Activation Settings
ACTIVATION_TOKEN_TTL_HOURS=72

# Password Hashing Algorithm Selection: argon2id (recommended) or bcrypt
HASH_ALGORITHM=argon2id

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Controlled File Upload Storage
# Options: local | s3
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Email Service Provider Configuration
# Options: development_log | smtp | sendgrid
EMAIL_PROVIDER=development_log
EMAIL_FROM_ADDRESS=noreply@smarthostel.internal
EMAIL_FROM_NAME="Smart Hostel Administration"

# SMTP Settings (Required only if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Daily Mess Operations Defaults
DEFAULT_LUNCH_CUTOFF_TIME=09:30
HOSTEL_TIMEZONE=Asia/Kolkata
