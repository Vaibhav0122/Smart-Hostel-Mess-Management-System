{
  "name": "smart-hostel-mess-management-system",
  "version": "1.0.0",
  "description": "Production-grade Smart Hostel and Mess Management System built with MERN stack & TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "rimraf dist && tsc",
    "build:backend": "rimraf dist && tsc",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "npm run build:backend && npm run build:frontend",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "lint:backend": "tsc --noEmit",
    "lint:frontend": "npm --prefix frontend run lint",
    "test": "jest --runInBand",
    "test:backend": "jest --runInBand"
  },
  "keywords": [
    "hostel-management",
    "mess-management",
    "mern",
    "typescript",
    "mongodb",
    "express"
  ],
  "author": "Smart Hostel Team",
  "license": "ISC",
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.45.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "jest": "^30.5.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
